{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "SimpleSplat",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.38)",
          "libvulkan1",
          "libgomp1",
          "libopengl0"
        ]
      },
      "rpm": {
        "depends": [
          "glibc >= 2.38",
          "vulkan-loader",
          "libgomp",
          "libglvnd-opengl"
        ]
      }
    }
  }
}
