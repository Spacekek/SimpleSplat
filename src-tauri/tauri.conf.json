{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleSplat",
  "identifier": "com.simplesplat.desktop",
  "build": {
    "beforeDevCommand": { "script": "python3 scripts/bundle_tools.py", "wait": true },
    "beforeBuildCommand": "python3 scripts/bundle_tools.py && python3 scripts/bundle_tools.py --app-notices",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SimpleSplat",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "tools/": "tools/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
